{
  "name": "repo-terminal-switcher",
  "displayName": "Repo Terminal Switcher",
  "description": "Keeps one PowerShell terminal synchronized with the Git repository of the active file.",
  "version": "1.1.5",
  "publisher": "mrjohndowe",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mrjohndowe/repo-terminal-switcher.git"
  },
  "bugs": {
    "url": "https://github.com/mrjohndowe/repo-terminal-switcher/issues"
  },
  "homepage": "https://github.com/mrjohndowe/repo-terminal-switcher#readme",
  "packageManager": "pnpm@11.19.0",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "repoTerminalSwitcher.syncNow",
        "title": "Repo Terminal: Sync to Active File"
      },
      {
        "command": "repoTerminalSwitcher.openForSourceControl",
        "title": "Open Repo Terminal",
        "icon": "$(terminal-powershell)"
      }
    ],
    "menus": {
      "scm/sourceControl": [
        {
          "command": "repoTerminalSwitcher.openForSourceControl",
          "when": "scmProvider == git",
          "group": "navigation@0"
        }
      ],
      "scm/repository": [
        {
          "command": "repoTerminalSwitcher.openForSourceControl",
          "when": "scmProvider == git",
          "group": "1_terminal@0"
        }
      ]
    },
    "configuration": {
      "title": "Repo Terminal Switcher",
      "properties": {
        "repoTerminalSwitcher.autoUpdate": {
          "type": "boolean",
          "default": true,
          "description": "Automatically install newer VSIX releases from the official GitHub repository. Reloading VS Code is still required to activate an installed update."
        }
      }
    }
  },
  "scripts": {
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.2"
  }
}
